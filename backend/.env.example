# Copy to backend/.env and fill in. Never commit backend/.env (gitignored).
MONGO_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rr_weather_manager

# Same license Worker origin as Website Pages (see Operations .../Website/wrangler.toml [vars] ROOTRECORD_API_BASE).
LICENSE_API_BASE_URL=https://rootrecord-license.wildecho94.workers.dev

# Comma-separated origins for browser dev, or * for permissive local testing.
CORS_ORIGINS=*

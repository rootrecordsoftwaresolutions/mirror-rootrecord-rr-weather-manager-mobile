# Copy to backend/.env and fill in. Never commit backend/.env (gitignored).
MONGO_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rr_weather_manager

CORS_ORIGINS=*

WEATHER_API_PUBLIC_URL=https://rootrecord-primary.rootrecord.workers.dev
ROOTRECORD_PRIMARY_API=https://rootrecord-primary.rootrecord.workers.dev

RR_PUSH_ADMIN_SECRET=
FCM_SERVICE_ACCOUNT_JSON=

# Dashboard snapshots in Mongo collection ``weather_data`` (TTL reuse + append history).
WEATHER_DATA_TTL_SEC=600
